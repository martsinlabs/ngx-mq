{
  "name": "ngx-mq",
  "version": "3.0.0-next.0",
  "description": "Signal-powered breakpoints and media queries for Angular.",
  "repository": {
    "type": "git",
    "url": "https://github.com/martsinlabs/ngx-mq.git"
  },
  "homepage": "https://github.com/martsinlabs/ngx-mq#readme",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "build": "ng-packagr -p ng-package.json",
    "build:watch": "ng-packagr -w -p ng-package.json",
    "size": "size-limit",
    "format": "prettier --write .",
    "clean": "rimraf dist"
  },
  "keywords": [
    "angular",
    "signals",
    "matchMedia",
    "media-query",
    "breakpoints",
    "responsive"
  ],
  "license": "MIT",
  "sideEffects": false,
  "author": "Myroslav Martsin",
  "workspaces": [
    "demo"
  ],
  "peerDependencies": {
    "@angular/common": ">=20 <23",
    "@angular/core": ">=20 <23"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.0",
    "@analogjs/vitest-angular": "^2.6.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^9.2.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "ng-packagr": "^20.3.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "size-limit": "^12.1.0",
    "typescript": "^5.5",
    "vite": "^7.1.5",
    "vitest": "^4.1.8"
  }
}
